<!-- COMPONENTES DE MODAL CUSTOMIZADOS -->
<div id="modalAppOverlay" class="modal-overlay" style="display:none;">
  <div class="modal-caixa">
    <div class="modal-titulo" id="modalAppTitulo">Aviso</div>
    <div class="modal-mensagem" id="modalAppMensagem">Mensagem</div>
    <div class="modal-acoes" id="modalAppAcoes">
      <button class="btn-principal" onclick="fecharModalApp()">OK</button>
    </div>
  </div>
</div>

<script>
/*************************************************
 * MODAIS CUSTOMIZADOS (DESIGN DO APP)
 *************************************************/
let modalConfirmCallback = null;

function exibirAvisoApp(titulo, mensagem) {
  document.getElementById('modalAppTitulo').textContent = titulo || 'Aviso';
  document.getElementById('modalAppMensagem').textContent = mensagem || '';
  document.getElementById('modalAppAcoes').innerHTML = 
    '<button class="btn-principal" onclick="fecharModalApp()">OK</button>';
  document.getElementById('modalAppOverlay').style.display = 'flex';
}

function exibirConfirmacaoApp(titulo, mensagem, callback) {
  modalConfirmCallback = callback;
  document.getElementById('modalAppTitulo').textContent = titulo || 'Confirmação';
  document.getElementById('modalAppMensagem').textContent = mensagem || '';
  document.getElementById('modalAppAcoes').innerHTML = 
    '<button class="btn-secundario" onclick="fecharModalApp(false)">Cancelar</button>' +
    '<button class="btn-sucesso" onclick="fecharModalApp(true)">Confirmar</button>';
  document.getElementById('modalAppOverlay').style.display = 'flex';
}

function fecharModalApp(resposta) {
  document.getElementById('modalAppOverlay').style.display = 'none';
  if (typeof modalConfirmCallback === 'function' && resposta !== undefined) {
    const fn = modalConfirmCallback;
    modalConfirmCallback = null;
    if (resposta) fn();
  }
}

/*************************************************
 * NAVEGAÇÃO
 *************************************************/
function mostrarPagina(id) {
  document.querySelectorAll('.page').forEach(page => page.classList.remove('active'));
  const p = document.getElementById(id);
  if (p) p.classList.add('active');
  const wrapper = document.querySelector('.app-wrapper');
  if (wrapper) wrapper.scrollTop = 0;
}

function voltarInicio() { mostrarPagina('paginaInicio'); carregarResumo(); carregarCongregacaoLocal(); }

function abrirTemas() { 
  mostrarPagina('paginaTemas'); 
  
  const campo = document.getElementById('campoTemas');
  if (campo) {
    campo.focus();
  }
}
function abrirTemasDoMes() { mostrarPagina('paginaTemasDoMes'); carregarMesesTemasDoMes(); }
function abrirTrocaTemas() { mostrarPagina('paginaTrocaTemas'); carregarMesesTrocaTemas(); }
function abrirTemasLocais() {
  mostrarPagina('paginaTemasLocais');
  carregarMesesTemasLocais();
}
function carregarMesesTemasLocais() {
  const select = document.getElementById('selectMesTemasLocais');
  if (!select) return;
  select.innerHTML = '<option value="">Carregando meses...</option>';

  google.script.run
    .withSuccessHandler(function(meses) {
      select.innerHTML = '<option value="">Selecione o mês</option>';
      (meses || []).forEach(function(item) {
        const option = document.createElement('option');
        option.value = item.valor;
        option.textContent = item.texto;
        select.appendChild(option);
      });
      carregarTemasLocaisTela();
    })
    .withFailureHandler(function(erro) {
      select.innerHTML = '<option value="">Erro ao carregar meses</option>';
    })
    .obterMeses();
}
function abrirCongregacoes() { mostrarPagina('paginaCongregacoes'); consultarCongregacoesTela(); }

function escapar(texto) {
  if (!texto) return '';
  return String(texto).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

/*************************************************
 * INÍCIO E CONGREGAÇÃO LOCAL
 *************************************************/
function carregarResumo() {
  google.script.run
    .withSuccessHandler(function(dados) {
      if(dados) {
        document.getElementById('totalTemas').textContent = dados.totalTemas || 0;
        document.getElementById('arranjoMes').textContent = dados.arranjoMes || 'Não programado';
        document.getElementById('proximoArranjo').textContent = dados.proximoArranjo || 'Não programado';
      }
    })
    .withFailureHandler(function(erro) { console.error(erro); })
    .obterResumoInicial();
}

function carregarCongregacaoLocal() {
  google.script.run
    .withSuccessHandler(function(dados) {
      if (dados && dados.nome) {
        document.getElementById('dispNomeLocal').textContent = dados.nome;
        document.getElementById('dispDiaHorarioLocal').textContent = (dados.dia || 'Dia não definido') + ' às ' + (dados.horario || '--:--');
        document.getElementById('dispEnderecoLocal').textContent = dados.endereco || 'Endereço não definido';
        
        document.getElementById('inputNomeLocal').value = dados.nome || '';
        document.getElementById('inputDiaLocal').value = dados.dia || '';
        document.getElementById('inputHorarioLocal').value = dados.horario || '';
        document.getElementById('inputEnderecoLocal').value = dados.endereco || '';
      } else {
        document.getElementById('dispNomeLocal').textContent = 'Nenhuma congregação cadastrada';
        document.getElementById('dispDiaHorarioLocal').textContent = 'Clique em Editar para preencher os dados.';
        document.getElementById('dispEnderecoLocal').textContent = '';
      }
    })
    .obterCongregacaoLocal();
}

function alternarEdicaoCongregacaoLocal() {
  const visualizacao = document.getElementById('visualizacaoCongregacaoLocal');
  const formulario = document.getElementById('formularioCongregacaoLocal');
  const btnEditar = document.getElementById('btnEditarCongregacaoLocal');

  if (formulario.style.display === 'none') {
    formulario.style.display = 'block';
    visualizacao.style.display = 'none';
    btnEditar.style.display = 'none';
  } else {
    formulario.style.display = 'none';
    visualizacao.style.display = 'block';
    btnEditar.style.display = 'block';
  }
}

function salvarCongregacaoLocalTela() {
  const dados = {
    nome: document.getElementById('inputNomeLocal').value.trim(),
    dia: document.getElementById('inputDiaLocal').value.trim(),
    horario: document.getElementById('inputHorarioLocal').value.trim(),
    endereco: document.getElementById('inputEnderecoLocal').value.trim()
  };

  if (!dados.nome) {
    exibirAvisoApp('Atenção', 'Informe o nome da congregação.');
    return;
  }

  google.script.run
    .withSuccessHandler(function() {
      alternarEdicaoCongregacaoLocal();
      carregarCongregacaoLocal();
      exibirAvisoApp('Sucesso', 'Informações da congregação local salvas.');
    })
    .withFailureHandler(function(erro) {
      exibirAvisoApp('Erro', 'Erro ao salvar congregação local: ' + (erro.message || erro));
    })
    .salvarCongregacaoLocal(dados);
}

/*************************************************
 * CONSULTAR TEMAS
 *************************************************/
let temasCache = [];

function consultarTemas() {
  const termo = document.getElementById('campoTema').value.trim();
  const resultado = document.getElementById('resultadoTemas');
  resultado.innerHTML = '<div class="card loading">Consultando...</div>';

  google.script.run
    .withSuccessHandler(function(dados) {
      temasCache = dados || [];
      if (!dados || dados.length === 0) {
        resultado.innerHTML = '<div class="card mensagem">Nenhum tema encontrado.</div>';
        return;
      }
      let html = '';
      dados.forEach(function(item) {
        let badgeSituacao = '';
        const sit = String(item.situacao || '').trim();
        if (sit.toLowerCase() === 'atualizado') {
          badgeSituacao = '<span class="badge-situacao badge-atualizado">Atualizado</span>';
        } else if (sit.toLowerCase() === 'descontinuado') {
          badgeSituacao = '<span class="badge-situacao badge-descontinuado">Descontinuado</span>';
        }

        html += '<div class="card">' +
          '<div style="display: flex; justify-content: space-between; align-items: flex-start;">' +
            '<div style="color: #1f4e78; font-weight: bold;">Tema nº ' + escapar(item.numero) + '</div>' +
            '<button class="btn-principal" style="padding: 6px 12px; font-size: 13px;" onclick="abrirFormularioEditarTema(' + item.linha + ')">✏️ Editar</button>' +
          '</div>' +
          '<div style="font-size: 18px; font-weight: bold; margin: 6px 0;">' + escapar(item.tema) + '</div>';

        if (item.assunto) {
          html += '<div style="color: #555;"><strong>Assunto:</strong> ' + escapar(item.assunto) + '</div>';
        }

        if (badgeSituacao) {
          html += '<div style="margin-top: 6px;"><strong>Situação:</strong> ' + badgeSituacao + '</div>';
        }

        if (item.apresentacoes && item.apresentacoes.length) {
          html += '<div style="margin-top: 10px;"><strong>Últimas apresentações:</strong><br>';
          item.apresentacoes.forEach(ap => { html += '<span class="chip">' + ap.ano + ' — ' + ap.data + '</span>'; });
          html += '</div>';
        }
        html += '</div>';
      });
      resultado.innerHTML = html;
    })
    .withFailureHandler(function(erro) {
      resultado.innerHTML = '<div class="card mensagem">Erro ao consultar os temas.<br>' + escapar(erro.message || erro) + '</div>';
    })
    .consultarTemas(termo);
}

function abrirFormularioNovoTema() {
  document.getElementById('temaLinha').value = '';
  document.getElementById('tituloFormTema').textContent = 'Adicionar Tema';
  document.getElementById('formTemaNumero').value = '';
  document.getElementById('formTemaTitulo').value = '';
  document.getElementById('formTemaAssunto').value = '';
  document.getElementById('formTemaSituacao').value = '';

  const form = document.getElementById('formularioTema');
  form.style.display = 'block';
  form.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function abrirFormularioEditarTema(linha) {
  const item = temasCache.find(t => Number(t.linha) === Number(linha));
  if (!item) { exibirAvisoApp('Aviso', 'Tema não encontrado.'); return; }

  document.getElementById('temaLinha').value = item.linha;
  document.getElementById('tituloFormTema').textContent = 'Editar Tema';
  document.getElementById('formTemaNumero').value = item.numero || '';
  document.getElementById('formTemaTitulo').value = item.tema || '';
  document.getElementById('formTemaAssunto').value = item.assunto || '';
  document.getElementById('formTemaSituacao').value = item.situacao || '';

  const form = document.getElementById('formularioTema');
  form.style.display = 'block';
  form.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function fecharFormularioTema() {
  document.getElementById('formularioTema').style.display = 'none';
}

function salvarTemaTela() {
  const dados = {
    linha: document.getElementById('temaLinha').value,
    numero: document.getElementById('formTemaNumero').value.trim(),
    tema: document.getElementById('formTemaTitulo').value.trim(),
    assunto: document.getElementById('formTemaAssunto').value.trim(),
    situacao: document.getElementById('formTemaSituacao').value
  };

  if (!dados.numero) { exibirAvisoApp('Aviso', 'Informe o número do tema.'); return; }
  if (!dados.tema) { exibirAvisoApp('Aviso', 'Informe o título do tema.'); return; }

  google.script.run
    .withSuccessHandler(function() {
      fecharFormularioTema();
      consultarTemas();
      carregarResumo();
      exibirAvisoApp('Sucesso', 'Tema salvo com sucesso.');
    })
    .withFailureHandler(function(erro) {
      exibirAvisoApp('Erro', 'Erro ao salvar tema: ' + (erro.message || erro));
    })
    .salvarTema(dados);
}

/*************************************************
 * CONGREGAÇÕES
 *************************************************/
let congregaçõesCache = [];

function consultarCongregacoesTela() {
  const termo = document.getElementById('campoPesquisaCongregacao').value.trim();
  const resultado = document.getElementById('resultadoCongregacoes');
  resultado.innerHTML = '<div class="card loading">Carregando congregações...</div>';

  google.script.run
    .withSuccessHandler(function(dados) {
      congregaçõesCache = dados || [];
      if (!dados || dados.length === 0) {
        resultado.innerHTML = '<div class="card mensagem">Nenhuma congregação encontrada.</div>';
        return;
      }

      let html = '';
      dados.forEach(function(item) {
        let linkMapa = item.localizacao ? '<a href="' + escapar(item.localizacao) + '" target="_blank" class="btn-link">🗺️ Mapa</a>' : '';
        let htmlOradores = '';
        if (item.oradoresTemas && item.oradoresTemas.length > 0) {
          htmlOradores = '<div style="margin-top: 10px; font-size: 14px; background: #f8f9fa; padding: 10px; border-radius: 6px;"><strong>Oradores e Discursos:</strong><ul style="margin: 6px 0 0 18px; padding: 0;">';
          item.oradoresTemas.forEach(ot => {
            htmlOradores += '<li style="margin-bottom: 4px;"><strong>' + escapar(ot.orador) + '</strong> — Nrs: ' + escapar(ot.numeros) + '</li>';
          });
          htmlOradores += '</ul></div>';
        }

        html += '<div class="card" style="margin-bottom: 12px;">' +
          '<div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 10px;">' +
          '<div style="flex: 1; word-break: break-word;">' +
          '<h3 style="margin: 0 0 6px 0; color: #1f4e78;">' + escapar(item.nome) + '</h3>' +
          '<div style="font-size: 14px;"><strong>Endereço:</strong> ' + escapar(item.endereco) + ' ' + linkMapa + '</div>' +
          '<div style="font-size: 14px; margin-top: 4px;"><strong>Reunião:</strong> ' + escapar(item.diaReuniao) + ' | <strong>Agenda:</strong> ' + escapar(item.agenda) + '</div>' +
          htmlOradores +
          '</div>' +
          '<div style="display: flex; gap: 4px; flex-shrink: 0;">' +
          '<button class="btn-principal" style="padding: 8px 10px; font-size: 13px;" onclick="abrirFormularioEditarCongregacao(' + item.linha + ')">✏️</button>' +
          '<button class="btn-perigo" style="padding: 8px 10px; font-size: 13px;" onclick="excluirCongregacaoTela(' + item.linha + ')">🗑️</button>' +
          '</div>' +
          '</div>' +
          '</div>';
      });
      resultado.innerHTML = html;
    })
    .withFailureHandler(function(erro) {
      resultado.innerHTML = '<div class="card mensagem">Erro ao carregar congregações.<br>' + escapar(erro.message || erro) + '</div>';
    })
    .consultarCongregacoes(termo);
}

function abrirFormularioNovaCongregacao() {
  document.getElementById('congLinha').value = '';
  document.getElementById('tituloFormCongregacao').textContent = 'Adicionar Congregação';
  document.getElementById('congNome').value = '';
  document.getElementById('congEndereco').value = '';
  document.getElementById('congLocalizacao').value = '';
  document.getElementById('congDia').value = '';
  document.getElementById('congAgenda').value = '';
  document.getElementById('listaOradoresForm').innerHTML = '';
  adicionarCampoOradorTema();

  const form = document.getElementById('formularioCongregacao');
  form.style.display = 'block';
  form.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function abrirFormularioEditarCongregacao(linha) {
  const item = congregaçõesCache.find(c => Number(c.linha) === Number(linha));
  if (!item) { exibirAvisoApp('Aviso', 'Congregação não encontrada.'); return; }

  document.getElementById('congLinha').value = item.linha;
  document.getElementById('tituloFormCongregacao').textContent = 'Editar Congregação';
  document.getElementById('congNome').value = item.nome || '';
  document.getElementById('congEndereco').value = item.endereco || '';
  document.getElementById('congLocalizacao').value = item.localizacao || '';
  document.getElementById('congDia').value = item.diaReuniao || '';
  document.getElementById('congAgenda').value = item.agenda || '';
  
  const containerOradores = document.getElementById('listaOradoresForm');
  containerOradores.innerHTML = '';

  if (item.oradoresTemas && item.oradoresTemas.length > 0) {
    item.oradoresTemas.forEach(ot => { adicionarCampoOradorTema(ot.orador, ot.numeros); });
  } else {
    adicionarCampoOradorTema();
  }

  const form = document.getElementById('formularioCongregacao');
  form.style.display = 'block';
  form.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function adicionarCampoOradorTema(orador = '', numeros = '') {
  const container = document.getElementById('listaOradoresForm');
  const div = document.createElement('div');
  div.className = 'form-grid';
  div.style.marginBottom = '8px';
