function consultarTrocaTemasTela() {
  const valorMes = document.getElementById('trocaMes').value;
  const resultado = document.getElementById('resultadoTrocaTemas');

  if (!valorMes) {
    resultado.innerHTML = '';
    return;
  }

  resultado.innerHTML = '<div class="card loading">Buscando a congregação agendada e os temas...</div>';

  google.script.run
    .withSuccessHandler(function(dados) {
      if (!dados || !dados.length) {
        resultado.innerHTML = '<div class="card mensagem">Nenhuma congregação foi encontrada com este mês na coluna Agenda.</div>';
        return;
      }

      let html = '';

      dados.forEach(function(cong, indiceCong) {
        html += '<div class="card troca-congregacao" data-congregacao-index="' + indiceCong + '">' +
          '<h3 style="margin-bottom:6px;">🏛️ ' + escapar(cong.congregacao) + '</h3>' +
          (cong.endereco ? '<div style="font-size:14px;color:#555;"><strong>Endereço:</strong> ' + escapar(cong.endereco) + '</div>' : '') +
          '<div style="margin-top:12px;"><strong>Selecione os temas para a troca:</strong></div>';

        if (!cong.oradores || !cong.oradores.length) {
          html += '<div class="mensagem">Nenhum orador cadastrado para esta agenda.</div>';
        } else {
          cong.oradores.forEach(function(orador, indiceOrador) {
            html += '<div class="troca-orador">' +
              '<div class="troca-orador-titulo">🎤 ' + escapar(orador.nome || 'Orador') + '</div>';

            if (!orador.temas || !orador.temas.length) {
              html += '<div style="color:#666;">Nenhum tema cadastrado para este orador.</div>';
            } else {
              orador.temas.forEach(function(tema, indiceTema) {
                const id = 'trocaTema_' + indiceCong + '_' + indiceOrador + '_' + indiceTema;
                
                let badgeSituacao = '';
                const sit = String(tema.situacao || '').trim();
                if (sit.toLowerCase() === 'atualizado') {
                  badgeSituacao = ' <span class="badge-situacao badge-atualizado">Atualizado</span>';
                } else if (sit.toLowerCase() === 'descontinuado') {
                  badgeSituacao = ' <span class="badge-situacao badge-descontinuado">Descontinuado</span>';
                }

                html += '<label class="troca-tema-item" for="' + id + '">' +
                  '<input type="checkbox" id="' + id + '" class="troca-checkbox" ' +
                  'data-congregacao="' + indiceCong + '" data-orador="' + indiceOrador + '" data-tema="' + indiceTema + '">' +
                  '<div class="troca-tema-info">' +
                  '<div class="troca-tema-nome">' + escapar(tema.numero) + ' — ' + escapar(tema.tema) + '</div>' +
                  '<div class="troca-tema-data">Última realização: ' + escapar(tema.ultimaData || 'não encontrada') + badgeSituacao + '</div>' +
                  '</div>' +
                  '</label>';
              });
            }

            html += '</div>';
          });
        }

        html += '<div class="troca-acoes">' +
          '<button class="btn-sucesso" onclick="criarArranjoTrocaTemas(' + indiceCong + ')">📅 Criar Arranjo</button>' +
          '<button class="btn-principal" onclick="enviarTrocaTemasWhatsApp(' + indiceCong + ')">📲 Enviar por WhatsApp</button>' +
          '<button class="btn-secundario" onclick="marcarNenhumTemaTroca(' + indiceCong + ')">Limpar seleção</button>' +
          '</div>' +
          '</div>';
      });

      resultado.innerHTML = html;
      window.dadosTrocaTemasAtual = dados;
    })
    .withFailureHandler(function(erro) {
      resultado.innerHTML = '<div class="card mensagem">Erro ao buscar a troca de temas.<br>' + escapar(erro.message || erro) + '</div>';
    })
    .consultarTrocaTemasPorMes(valorMes);
}

function criarArranjoTrocaTemas(indiceCong) {
  const dados = window.dadosTrocaTemasAtual || [];
  const congregacao = dados[indiceCong];
  if (!congregacao) return;

  const checkboxes = document.querySelectorAll('.troca-checkbox[data-congregacao="' + indiceCong + '"]:checked');
  if (!checkboxes.length) {
    exibirAvisoApp('Atenção', 'Selecione pelo menos um tema para criar o arranjo.');
    return;
  }

  const valorMes = document.getElementById('trocaMes').value;
  if (!valorMes) {
    exibirAvisoApp('Atenção', 'Selecione um mês válido.');
    return;
  }

  const itensSelecionados = [];

  checkboxes.forEach(function(cb) {
    const indiceOrador = Number(cb.dataset.orador);
    const indiceTema = Number(cb.dataset.tema);
    const orador = congregacao.oradores[indiceOrador];
    const tema = orador && orador.temas ? orador.temas[indiceTema] : null;

    if (orador && tema) {
      itensSelecionados.push({
        orador: orador.nome,
        numero: tema.numero,
        tema: tema.tema
      });
    }
  });

  exibirConfirmacaoApp(
    'Criar Arranjo',
    'Deseja criar o arranjo com ' + itensSelecionados.length + ' discurso(s) selecionado(s) e salvar em "Tema do Mês"?',
    function() {
      const dadosArranjo = {
        valorMes: valorMes,
        congregacaoVisitante: congregacao.congregacao,
        itens: itensSelecionados
      };

      google.script.run
        .withSuccessHandler(function(res) {
          exibirAvisoApp('Sucesso', 'Arranjo criado com sucesso! ' + res.quantidade + ' discurso(s) adicionado(s) na página Tema do Mês.');
        })
        .withFailureHandler(function(erro) {
          exibirAvisoApp('Erro', 'Erro ao criar arranjo: ' + (erro.message || erro));
        })
        .salvarArranjoTrocaTemas(dadosArranjo);
    }
  );
}

