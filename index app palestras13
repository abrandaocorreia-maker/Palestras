  const selectTema = document.getElementById('selectTemaLocalIndividual');
  const tema = document.getElementById('titTemaLocalIndividual');
  selectTema.innerHTML = '<option value="">Selecione o número do discurso</option>';
  selectTema.disabled = true;
  tema.value = '';
  if (!select.value) {
    return;
  }
  const selecionado = listaOradoresLocaisCache[Number(select.value)];
  if (!selecionado || !selecionado.temas) return;
  selecionado.temas.forEach(function(item, indice) {
    const option = document.createElement('option');
    option.value = indice;
    option.textContent = item.numero ? 'Nº ' + item.numero : 'Sem número cadastrado';
    selectTema.appendChild(option);
  });
  selectTema.disabled = selecionado.temas.length === 0;
}

function selecionarTemaLocalIndividual() {
  const idxOrador = document.getElementById('selectOradorLocalIndividual').value;
  const idxTema = document.getElementById('selectTemaLocalIndividual').value;
  const campoTema = document.getElementById('titTemaLocalIndividual');
  if (idxOrador === '' || idxTema === '') { campoTema.value = ''; return; }
  const item = listaOradoresLocaisCache[Number(idxOrador)].temas[Number(idxTema)];
  campoTema.value = item ? item.tema || '' : '';
}

function preencherDatasReuniao(valorMes, diaReuniao) {
  const select = document.getElementById('selectDataHoraReuniao');
  select.innerHTML = '<option value="">Selecione a data da reunião</option>';
  if (!valorMes || !diaReuniao) return;

  const normalizado = String(diaReuniao).normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const dias = [
    { nomes: ['domingo'], numero: 0 }, { nomes: ['segunda'], numero: 1 },
    { nomes: ['terca'], numero: 2 }, { nomes: ['quarta'], numero: 3 },
    { nomes: ['quinta'], numero: 4 }, { nomes: ['sexta'], numero: 5 },
    { nomes: ['sabado'], numero: 6 }
  ];
  const diaSemana = dias.find(function(item) { return item.nomes.some(function(nome) { return normalizado.includes(nome); }); });
  const textoHorario = String(diaReuniao);
  const horarioEncontrado = textoHorario.match(/\b([01]?\d|2[0-3])\s*(?::|h)\s*([0-5]\d)\b/i);
  const horario = horarioEncontrado ? String(Number(horarioEncontrado[1])).padStart(2, '0') + ':' + horarioEncontrado[2] : '';
  if (!diaSemana) {
    select.innerHTML = '<option value="">Dia da reunião não identificado no cadastro</option>';
    return;
  }

  const partes = valorMes.split('-');
  const ano = Number(partes[0]), mes = Number(partes[1]);
  const totalDias = new Date(ano, mes, 0).getDate();
  for (let dia = 1; dia <= totalDias; dia++) {
    const data = new Date(ano, mes - 1, dia);
    if (data.getDay() !== diaSemana.numero) continue;
    const iso = ano + '-' + String(mes).padStart(2, '0') + '-' + String(dia).padStart(2, '0');
    const label = String(dia).padStart(2, '0') + '/' + String(mes).padStart(2, '0') + '/' + ano + (horario ? ' às ' + horario : '');
    const option = document.createElement('option');
    option.value = iso;
    option.textContent = label;
    select.appendChild(option);
  }
}

function alternarOradoresCadastrados(botao) {
  const container = document.getElementById('containerOradoresLocais');
  const mostrar = container.style.display === 'none';
  container.style.display = mostrar ? 'block' : 'none';
  botao.textContent = mostrar ? 'Ocultar cadastrados' : 'Mostrar cadastrados';
  if (mostrar) renderizarOradoresCadastrados();
}

function renderizarOradoresCadastrados() {
  const container = document.getElementById('containerOradoresLocais');
  if (!listaOradoresLocaisCache.length) {
    container.innerHTML = '<div class="card mensagem">Nenhum orador local cadastrado.</div>';
    return;
  }
  let html = '<div class="card troca-congregacao"><h3 style="margin-top:0;color:#1f4e78;">Oradores cadastrados</h3>';
  listaOradoresLocaisCache.forEach(function(orador) {
    html += '<div class="troca-orador" style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;">' +
      '<div><strong>🎤 ' + escapar(orador.nome) + '</strong>' +
      (orador.telefone ? '<div style="color:#666;font-size:13px;">' + escapar(orador.telefone) + '</div>' : '') +
      (orador.observacao ? '<div style="color:#666;font-size:13px;">' + escapar(orador.observacao) + '</div>' : '') + '</div>' +
      '<div class="troca-acoes" style="margin-top:0;">' +
      '<button class="btn-secundario" onclick="abrirFormularioOradorLocal(' + orador.linha + ')">✏ Editar</button>' +
      '<button class="btn-perigo" onclick="excluirOradorLocalTela(' + orador.linha + ')">🗑 Excluir</button>' +
      '</div></div>';
  });
  container.innerHTML = html + '</div>';
}

function enviarOradorLocalWhatsApp() {
  const selectMes = document.getElementById('selectMesTemasLocais');
  const select = document.getElementById('selectOradorLocalIndividual');
  if (!selectMes.value) { exibirAvisoApp('Atenção', 'Selecione o mês antes de enviar.'); return; }
  if (!select.value) { exibirAvisoApp('Atenção', 'Escolha um orador local.'); return; }
  const orador = listaOradoresLocaisCache[Number(select.value)];
  const selectTema = document.getElementById('selectTemaLocalIndividual');
  if (!selectTema.value) { exibirAvisoApp('Atenção', 'Escolha o número do discurso.'); return; }
  const itemTema = orador.temas[Number(selectTema.value)];
  const tema = document.getElementById('titTemaLocalIndividual').value.trim();
  const dataHora = document.getElementById('selectDataHoraReuniao').selectedOptions[0];
  if (!dataHora || !dataHora.value) { exibirAvisoApp('Atenção', 'Escolha uma data de reunião válida.'); return; }
  const congregacao = document.getElementById('lblCongregacaoArranjo').textContent;
  const endereco = document.getElementById('lblEnderecoArranjo').textContent;
  if (!tema || !congregacao || congregacao === 'Não definida') { exibirAvisoApp('Atenção', 'Não há uma congregação programada para este mês.'); return; }
  const localizacao = document.getElementById('linkLocalizacaoArranjo').dataset.url || '';
  const mensagem = montarMensagemDesignacaoLocal({
    nome: orador.nome, dataHora: dataHora.textContent, numero: itemTema.numero, tema: tema,
    congregacao: congregacao, endereco: endereco, localizacao: localizacao
  });
  window.open('https://api.whatsapp.com/send?text=' + encodeURIComponent(mensagem.trim()), '_blank');
}

function montarMensagemDesignacaoLocal(dados) {
  let mensagem = 'Olá! Segue a sua próxima designação de discurso público:\n\n';
  if (dados.incluirOrador && dados.nome) mensagem += 'Orador: ' + dados.nome + '\n';
  mensagem += 'Data e hora: ' + dados.dataHora + '\n';
  mensagem += 'Tema: ' + (dados.numero ? 'Nº ' + dados.numero + ' — ' : '') + dados.tema + '\n\n';
  mensagem += 'Congregação: ' + dados.congregacao + '\n';
  mensagem += 'Endereço: ' + dados.endereco + '\n\n';
  mensagem += 'Link do google: ' + (dados.localizacao || 'Não informado') + '\n\n';
  mensagem += 'Atenciosamente, Arranjo de Oradores Congr. Vila Emil.';
  return mensagem;
}

function abrirEscolhaOradoresWhatsApp() {
  const lista = document.getElementById('listaEscolhaOradores');
  lista.innerHTML = '<div class="loading">Buscando os cadastros na planilha...</div>';
  document.getElementById('modalEscolherOradores').style.display = 'flex';
  google.script.run
    .withSuccessHandler(function(dados) {
      const selectAtual = document.getElementById('selectOradorLocalIndividual');
      const linhaSelecionada = selectAtual.value && listaOradoresLocaisCache[Number(selectAtual.value)]
        ? listaOradoresLocaisCache[Number(selectAtual.value)].linha : null;
      listaOradoresLocaisCache = dados.oradores || [];
      listaTemasLocaisDisponiveisCache = dados.temasDisponiveis || listaTemasLocaisDisponiveisCache;
      catalogoTemasLocaisCarregado = true;
      renderizarSelecaoOradoresLocais(listaOradoresLocaisCache);
      if (linhaSelecionada) {
        const novoIndice = listaOradoresLocaisCache.findIndex(function(o) { return Number(o.linha) === Number(linhaSelecionada); });
        if (novoIndice >= 0) {
          selectAtual.value = String(novoIndice);
          selecionarOradorLocalIndividual();
        }
      }
      if (!listaOradoresLocaisCache.length) {
        lista.innerHTML = '<div class="mensagem">Nenhum orador local cadastrado na aba Temas Locais.</div>';
        return;
      }
      let html = '';
      listaOradoresLocaisCache.forEach(function(orador, idx) {
        const id = 'checkEscolherOrador_' + idx;
        const numeros = (orador.temas || []).map(function(item) { return String(item.numero || '').trim(); }).filter(function(numero) { return numero; });
        const numerosUnicos = Array.from(new Set(numeros));
        const textoTemas = numerosUnicos.length ? numerosUnicos.map(escapar).join(', ') : 'Nenhum número de tema cadastrado';
        html += '<div class="troca-tema-item">' +
          '<input type="checkbox" id="' + id + '" value="' + idx + '">' +
          '<div class="troca-tema-info"><label class="troca-tema-nome" for="' + id + '">' + escapar(orador.nome) + '</label>' +
          '<div><strong>Temas:</strong> ' + textoTemas + '</div></div></div>';
      });
      lista.innerHTML = html;
      const cadastrados = document.getElementById('containerOradoresLocais');
      if (cadastrados.style.display !== 'none') renderizarOradoresCadastrados();
    })
    .withFailureHandler(function(erro) {
      lista.innerHTML = '<div class="mensagem">Erro ao consultar a planilha.<br>' + escapar(erro.message || erro) + '</div>';
    })
    .consultarTemasLocaisTelaBackend('');
}

function fecharEscolhaOradores() {
  document.getElementById('modalEscolherOradores').style.display = 'none';
}

function enviarOradoresEscolhidosWhatsApp() {
  const indices = Array.from(document.querySelectorAll('#listaEscolhaOradores input[type="checkbox"]:checked'))
    .map(function(cb) { return Number(cb.value); });
  if (!indices.length) { exibirAvisoApp('Atenção', 'Marque pelo menos um orador.'); return; }

  const selecionados = indices.map(function(idx) { return listaOradoresLocaisCache[idx]; }).filter(function(orador) { return !!orador; });
  const mensagem = 'Olá! Segue a lista de oradores e temas da congregação Vila Emil para nosso próximo arranjo:\n\n' +
    selecionados.map(function(orador) {
      const numeros = Array.from(new Set((orador.temas || []).map(function(item) { return String(item.numero || '').trim(); }).filter(function(numero) { return numero; })));
      return orador.nome + '\nTemas: ' + (numeros.length ? numeros.join(', ') : 'Nenhum número de tema cadastrado');
    }).join('\n\n');
  const popup = window.open('about:blank', '_blank');
  if (!popup) { exibirAvisoApp('Atenção', 'Permita a abertura de janelas para continuar para o WhatsApp.'); return; }
  fecharEscolhaOradores();
  popup.location = 'https://api.whatsapp.com/send?text=' + encodeURIComponent(mensagem);
}

function abrirFormularioOradorLocal(linha) {
  if (!catalogoTemasLocaisCarregado) {
    google.script.run
      .withSuccessHandler(function(dados) {
        listaTemasLocaisDisponiveisCache = dados.temasDisponiveis || [];
        listaOradoresLocaisCache = dados.oradores || listaOradoresLocaisCache;
        catalogoTemasLocaisCarregado = true;
        abrirFormularioOradorLocal(linha);
      })
      .withFailureHandler(function(erro) {
        exibirAvisoApp('Erro', 'Não foi possível carregar os temas: ' + (erro.message || erro));
      })
      .consultarTemasLocaisTelaBackend(document.getElementById('selectMesTemasLocais').value);
    return;
  }
  const item = linha ? listaOradoresLocaisCache.find(o => Number(o.linha) === Number(linha)) : null;
  document.getElementById('oradorLocalLinha').value = item ? item.linha : '';
  document.getElementById('tituloFormularioOradorLocal').textContent = item ? 'Editar orador local' : 'Cadastrar orador local';
  document.getElementById('oradorLocalNome').value = item ? item.nome : '';
  const atuais = document.getElementById('temasAtuaisOradorLocal');
  atuais.innerHTML = item && item.temas && item.temas.length
    ? item.temas.map(function(tema) { return '<span class="tag-tema">Nº ' + escapar(tema.numero || '—') + ': ' + escapar(tema.tema || 'Tema sem título') + '</span>'; }).join(' ')
    : 'Nenhum tema cadastrado.';
  const seletor = document.getElementById('temasNovosOradorLocal');
  seletor.innerHTML = '';
  const numerosAtuais = new Set((item && item.temas || []).map(function(tema) { return String(tema.numero || '').trim().toLowerCase(); }));
  listaTemasLocaisDisponiveisCache.forEach(function(tema) {
    if (numerosAtuais.has(String(tema.numero || '').trim().toLowerCase())) return;
    const option = document.createElement('option');
    option.value = tema.numero;
    option.textContent = 'Nº ' + tema.numero + ' — ' + tema.tema;
    seletor.appendChild(option);
  });
  if (!listaTemasLocaisDisponiveisCache.length) {
    const option = document.createElement('option');
    option.value = '';
    option.textContent = 'Nenhum tema disponível na aba Temas';
    option.disabled = true;
    seletor.appendChild(option);
  }
  const form = document.getElementById('formularioOradorLocal');
  form.style.display = 'block';
  form.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function fecharFormularioOradorLocal() {
  document.getElementById('formularioOradorLocal').style.display = 'none';
}

function salvarOradorLocalTela() {
  const temasSelecionados = Array.from(document.getElementById('temasNovosOradorLocal').selectedOptions)
    .filter(function(option) { return option.value; })
    .map(function(option) { return option.value; });
  const dados = {
    linha: document.getElementById('oradorLocalLinha').value,
    nome: document.getElementById('oradorLocalNome').value.trim(),
    temas: temasSelecionados
  };
  if (!dados.nome) {
    exibirAvisoApp('Atenção', 'Informe o nome do orador local.');
    return;
  }
  if (!dados.linha && !dados.temas.length) {
    exibirAvisoApp('Atenção', 'Selecione pelo menos um tema para cadastrar o orador.');
    return;
  }
  google.script.run
    .withSuccessHandler(function() {
      fecharFormularioOradorLocal();
      carregarTemasLocaisTela();
      exibirAvisoApp('Sucesso', 'Cadastro do orador local salvo.');
    })
    .withFailureHandler(function(erro) {
      exibirAvisoApp('Erro', 'Não foi possível salvar o cadastro: ' + (erro.message || erro));
    })
    .salvarOradorLocal(dados);
}

function excluirOradorLocalTela(linha) {
  const item = listaOradoresLocaisCache.find(o => Number(o.linha) === Number(linha));
  exibirConfirmacaoApp('Excluir orador local', 'Deseja excluir o cadastro de ' + (item ? item.nome : 'este orador') + '?', function() {
    google.script.run
      .withSuccessHandler(function() {
        carregarTemasLocaisTela();
        exibirAvisoApp('Sucesso', 'Cadastro do orador local excluído.');
      })
      .withFailureHandler(function(erro) {
        exibirAvisoApp('Erro', 'Não foi possível excluir o cadastro: ' + (erro.message || erro));
      })
      .excluirOradorLocal(linha);
  });
}

function salvarDataOradorLocalTela(linha) {
  const dataVal = document.getElementById('dtLocal_' + linha).value;
  if (!dataVal) {
    exibirAvisoApp('Atenção', 'Informe uma data válida.');
    return;
  }

  google.script.run
    .withSuccessHandler(function(res) {
      exibirAvisoApp('Sucesso', res.mensagem);
    })
    .withFailureHandler(function(erro) {
      exibirAvisoApp('Erro', 'Erro ao salvar data: ' + (erro.message || erro));
    })
    .salvarDataOradorLocal({ linha: linha, data: dataVal });
}

