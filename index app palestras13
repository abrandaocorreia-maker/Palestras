function enviarTrocaTemasWhatsApp(indiceCong) {
  const dados = window.dadosTrocaTemasAtual || [];
  const congregacao = dados[indiceCong];
  if (!congregacao) return;

  const checkboxes = document.querySelectorAll('.troca-checkbox[data-congregacao="' + indiceCong + '"]:checked');
  if (!checkboxes.length) {
    exibirAvisoApp('Atenção', 'Selecione pelo menos um tema para enviar.');
    return;
  }

  const selecionados = {};

  checkboxes.forEach(function(cb) {
    const indiceOrador = Number(cb.dataset.orador);
    const indiceTema = Number(cb.dataset.tema);
    const orador = congregacao.oradores[indiceOrador];
    const tema = orador && orador.temas ? orador.temas[indiceTema] : null;
    if (!orador || !tema) return;

    if (!selecionados[indiceOrador]) {
      selecionados[indiceOrador] = { nome: orador.nome, temas: [] };
    }
    selecionados[indiceOrador].temas.push(tema);
  });

  const select = document.getElementById('trocaMes');
  const mesTexto = select && select.selectedOptions.length ? select.selectedOptions[0].textContent : '';

  let mensagem = 'Troca de Temas — ' + mesTexto + '\n';
  mensagem += 'Congregação: ' + congregacao.congregacao + '\n\n';

  Object.keys(selecionados).forEach(function(chave) {
    const item = selecionados[chave];
    mensagem += item.nome + '\n';
    item.temas.forEach(function(tema) {
      mensagem += '• ' + tema.numero + ' — ' + tema.tema + '\n';
    });
    mensagem += '\n';
  });

  const url = 'https://wa.me/?text=' + encodeURIComponent(mensagem.trim());
  window.open(url, '_blank');
}

