function salvarDataRealizacaoLocalTela(idx) {
  const orador = listaOradoresLocaisCache[idx];
  const novaData = document.getElementById('dataRealizacaoLoc_' + idx).value;

  if (!novaData) {
    exibirAvisoApp('Atenção', 'Selecione a data de realização antes de salvar.');
    return;
  }

  const partes = novaData.split('-');
  const dataBR = partes.length === 3 ? partes[2] + '/' + partes[1] + '/' + partes[0] : novaData;

  exibirConfirmacaoApp(
    'Salvar Data',
    'Deseja salvar a data (' + dataBR + ') para o orador ' + orador.nome + ' na planilha?',
    function() {
      google.script.run
        .withSuccessHandler(function(res) {
          exibirAvisoApp('Sucesso', res.mensagem);
          orador.dataRealizacao = novaData;
        })
        .withFailureHandler(function(erro) {
          exibirAvisoApp('Erro', 'Erro ao salvar: ' + (erro.message || erro));
        })
        .salvarDataOradorLocal({ linha: orador.linha, data: novaData });
    }
  );
}

function salvarEdicaoOradorLocal(idx) {
  const orador = listaOradoresLocaisCache[idx];
  const dadosAtualizados = {
    linha: orador.linha,
    nome: orador.nome,
    numero: document.getElementById('numTemaLoc_' + idx).value.trim(),
    tema: document.getElementById('titTemaLoc_' + idx).value.trim()
  };

  google.script.run
    .withSuccessHandler(function(res) {
      exibirAvisoApp('Sucesso', res.mensagem);
      orador.numeroTema = dadosAtualizados.numero;
      orador.temaDefinido = dadosAtualizados.tema;
    })
    .withFailureHandler(function(erro) {
      exibirAvisoApp('Erro', 'Erro ao salvar alterações: ' + (erro.message || erro));
    })
    .salvarDadosOradorLocal(dadosAtualizados);
}

function enviarDesignacaoWhatsAppLocal(idx) {
  const orador = listaOradoresLocaisCache[idx];
  const selecionado = document.getElementById('temaLocalSelecionado_' + idx);
  if (!selecionado || !selecionado.checked) {
    exibirAvisoApp('Atenção', 'Marque a caixa ao lado do orador antes de enviar a designação.');
    return;
  }
  const numTema = document.getElementById('numTemaLoc_' + idx).value.trim();
  const titTema = document.getElementById('titTemaLoc_' + idx).value.trim();
  if (!numTema || !titTema || titTema.indexOf('Buscando') === 0 || titTema === 'Tema não encontrado' || titTema.indexOf('Não foi possível') === 0) {
    exibirAvisoApp('Atenção', 'Informe um número de discurso válido e aguarde a busca do tema.');
    return;
  }
  const congregacao = document.getElementById('lblCongregacaoArranjo').textContent;
  const endereco = document.getElementById('lblEnderecoArranjo').textContent;
  const selectMes = document.getElementById('selectMesTemasLocais');
  const mesTexto = selectMes && selectMes.selectedOptions.length ? selectMes.selectedOptions[0].textContent : '';

  let texto = 'Olá, irmão ' + orador.nome + '!\n\n';
  texto += 'Segue a sua designação de discurso:\n';
  texto += '📅 Mês: ' + mesTexto + '\n';
  texto += '📖 Tema: Nº ' + numTema + ' — ' + titTema + '\n';
  if (congregacao && congregacao !== 'Não definida') {
    texto += '🏛️ Congregação: ' + congregacao + '\n';
    texto += '📍 Endereço: ' + endereco + '\n';
  }

  const url = 'https://api.whatsapp.com/send?text=' + encodeURIComponent(texto);
  window.open(url, '_blank');
}

